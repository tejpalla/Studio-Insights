# OPENAI_API_KEY: Required for arena / insights.
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Model: gpt-5.6 = flagship. Alternatives: gpt-5.6-terra, gpt-5.6-luna.
OPENAI_MODEL="gpt-5.6"
# OPENAI_ARENA_MODEL="gpt-5.6-terra"
OPENAI_REASONING_EFFORT="high"

Databricks — Unity Catalog volume sync after each arena run
DATABRICKS_HOST="https://dbc-xxxx.cloud.databricks.com"
DATABRICKS_TOKEN="dapi..."
DATABRICKS_CATALOG="workspace"
DATABRICKS_SCHEMA="default"
DATABRICKS_VOLUME="helix_arena"

# APP_URL="http://localhost:3000"
