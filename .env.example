# OPENAI_API_KEY: Required for Run Insights (live model).
OPENAI_API_KEY="MY_OPENAI_API_KEY"

# Model: gpt-5.6 = flagship Sol. Alternatives: gpt-5.6-terra (cheaper), gpt-5.6-luna (fast).
OPENAI_MODEL="gpt-5.6"

# Reasoning for GPT-5.6 Responses API: low | medium | high (default high for denser fandom feeds)
OPENAI_REASONING_EFFORT="high"

# Optional: APP_URL for production hosting
# APP_URL="http://localhost:3000"
